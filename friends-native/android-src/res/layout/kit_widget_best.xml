<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/kit_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/kit_bhead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/kit_bcount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kit_btitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEEF1FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/kit_bsub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF8F98BD"
                android:textSize="12sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kit_b1"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kit_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FF6FD6A0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/kit_b1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEEF1FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="150dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  "
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/kit_b1_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textColor="#FF6FD6A0"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/kit_b1_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF8F98BD"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/kit_b1_call"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="9dp"
            android:background="@drawable/kit_call_on"
            android:src="@drawable/kit_ic_call"
            android:tint="#FF0B1022" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kit_b2"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kit_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FF6FD6A0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/kit_b2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEEF1FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="150dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  "
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/kit_b2_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textColor="#FF6FD6A0"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/kit_b2_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF8F98BD"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/kit_b2_call"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="9dp"
            android:background="@drawable/kit_call_on"
            android:src="@drawable/kit_ic_call"
            android:tint="#FF0B1022" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kit_b3"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/kit_row_bg"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FF6FD6A0"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/kit_b3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFEEF1FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:maxWidth="150dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  "
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/kit_b3_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textColor="#FF6FD6A0"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/kit_b3_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF8F98BD"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageView
            android:id="@+id/kit_b3_call"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:padding="9dp"
            android:background="@drawable/kit_call_on"
            android:src="@drawable/kit_ic_call"
            android:tint="#FF0B1022" />
    </LinearLayout>

    <TextView
        android:id="@+id/kit_bempty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="6dp"
        android:textColor="#FFC9D0EE"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
