<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/kit_row_bg"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/kit_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/kit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFEEF1FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/kit_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="h:mm a"
                android:format24Hour="h:mm a"
                android:textSize="12sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/kit_meta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FF8F98BD"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/kit_wa"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="6dp"
        android:padding="9dp"
        android:background="@drawable/kit_wa_bg"
        android:src="@drawable/kit_ic_chat" />

    <ImageView
        android:id="@+id/kit_call"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="8dp"
        android:padding="10dp"
        android:background="@drawable/kit_call_on"
        android:src="@drawable/kit_ic_call" />
</LinearLayout>
