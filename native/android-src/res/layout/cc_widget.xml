<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/cc_w_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/cw_sh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/cc_w_pill"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#E6EBFF"
            android:textSize="12sp"
            android:text="0/4 shiurim" />

        <TextView
            android:id="@+id/cw_he"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textDirection="rtl"
            android:fontFamily="serif"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:singleLine="true"
            android:text="Chabad Calendar" />
    </LinearLayout>

    <TextView
        android:id="@+id/cw_en"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="#AEB8E6"
        android:textSize="13sp"
        android:singleLine="true"
        android:text="" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#26FFFFFF" />

    <TextView android:id="@+id/cw_l1" style="@style/CcWLine" />
    <TextView android:id="@+id/cw_l2" style="@style/CcWLine" />
    <TextView android:id="@+id/cw_l3" style="@style/CcWLine" />
    <TextView android:id="@+id/cw_l4" style="@style/CcWLine" />
    <TextView android:id="@+id/cw_l5" style="@style/CcWLine" />
</LinearLayout>
